{
  "name": "ADM Grão 1000",
  "short_name": "ADM G1000",
  "description": "PWA administrativo da Grão 1000 para acesso mobile a estoque e rotinas do menu ADM.",
  "start_url": "/painel/adm-app",
  "scope": "/painel/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#03140d",
  "theme_color": "#052e1b",
  "icons": [
    { "src": "/painel/assets/icons/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/painel/assets/icons/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Estoque",
      "short_name": "Estoque",
      "description": "Abrir estoque de compras.",
      "url": "/painel/compras-estoque",
      "icons": [{ "src": "/painel/assets/icons/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Painel de Compras",
      "short_name": "Compras",
      "description": "Abrir painel administrativo de compras.",
      "url": "/painel/adm-compras",
      "icons": [{ "src": "/painel/assets/icons/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Logística",
      "short_name": "Logística",
      "description": "Abrir painel administrativo de logística.",
      "url": "/painel/adm-logistica",
      "icons": [{ "src": "/painel/assets/icons/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Usuários",
      "short_name": "Usuários",
      "description": "Abrir usuários e acessos.",
      "url": "/painel/admin-usuarios",
      "icons": [{ "src": "/painel/assets/icons/pwa-192.png", "sizes": "192x192" }]
    }
  ]
}
