# GRM Server Colaboradores Sync - Configuração de Secrets
#
# Copiar este arquivo para .env e preencher com dados reais:
# cp .env.example .env
#
# NÃO commitar o arquivo .env no git!
# Adicionar .env ao .gitignore

# Credenciais do GRM Server
# Usuário para fazer login em https://www.grmserver.com.br/login
GRMSERVER_USER=seu_usuario@grao.com.br

# Senha do GRM Server
GRMSERVER_PASSWORD=sua_senha_segura_123

# Credenciais do painel Ouro Safra (app.ourosafra.com.br)
# Usadas por grm-sync-classificacao-ourosafra.js
OUROSAFRA_USER=seu_cpf_ou_cnpj
OUROSAFRA_PASSWORD=sua_senha_segura_123

# Opcional: quantos dias pra trás buscar a carga no relatório de
# classificação do GRM ao procurar correspondência de uma placa (padrão: 3)
OUROSAFRA_GRM_DIAS_BUSCA=3

# URL do projeto Supabase
# Encontrar em: Dashboard Supabase → Settings → General → URL
SUPABASE_URL=https://seu-projeto-xxx.supabase.co

# API Key do Supabase
# Encontrar em: Dashboard Supabase → Settings → API → anon public / service_role
# Usar 'service_role' se o script rodar em backend (servidor)
# Usar 'anon public' se rodar no frontend (navegador)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: Configurações de logging e debug
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info
