# Copie para /etc/grao1000/paddleocr-worker.env e proteja com chmod 600.
SUPABASE_URL=https://jbzmcyycanrlnfhedcup.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI

OCR_WORKER_ID=server-grao1000-paddleocr
OCR_POLL_SECONDS=3
OCR_MAX_FILE_MB=100
OCR_MAX_PAGES=200
OCR_RENDER_DPI=180

PADDLE_OCR_LANG=pt
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_MIN_SCORE=0.35
PADDLE_OCR_DOC_ORIENTATION=false
PADDLE_OCR_UNWARP=false
PADDLE_OCR_TEXTLINE_ORIENTATION=false

# Evita depender do Hugging Face quando o servidor tiver bloqueio de rota.
PADDLE_PDX_MODEL_SOURCE=BOS
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
LOG_LEVEL=INFO
